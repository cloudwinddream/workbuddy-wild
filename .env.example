# ============================================================
# 本地敏感配置（不会被 git 提交，见 .gitignore）
# 用法：cp .env.example .env  然后填真实值
# ============================================================

# ---- 福利吧论坛签到（wnflb-checkin sidecar）----
FORUM_USERNAME=
FORUM_PASSWORD=
# 直接给 Cookie（可选，优先级高于账号密码登录）
# FORUM_COOKIE=
# 微信推送（可选，二选一或都填）
# PUSHPLUS_TOKEN=
# SERVERCHAN_KEY=
# 签到时刻表（北京时间，逗号分隔）
# WNFLB_CHECKIN_TIMES=01:00,22:00
# 启动后是否先跑一次签到（true/false）
# WNFLB_RUN_ON_STARTUP=true

# ---- 构建加速（可选）----
# 国内服务器 pip 拉取慢/失败时，取消注释用清华源
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
