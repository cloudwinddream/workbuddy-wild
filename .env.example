# ============================================================
# 本地敏感配置（不会被 git 提交，见 .gitignore）
# 用法：cp .env.example .env  然后填真实值
# ============================================================

# ---- 福利吧论坛签到（Go 原生模块，管理页 /wnflb/）----
# 账号也可在网页上直接登录；这里填了则容器首次启动时自动导入。
FORUM_USERNAME=
FORUM_PASSWORD=
# 签到时刻表（北京时间，逗号分隔）
# WNFLB_CHECKIN_TIMES=01:00,22:00
# 启动后是否先跑一次签到（true/false）
# WNFLB_RUN_ON_STARTUP=true
# 论坛基址（论坛换域名时改这里）
# WNFLB_BASE_URL=https://www.wnflb2023.com
