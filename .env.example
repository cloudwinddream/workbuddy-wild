# ============================================================
# 本地敏感配置（不会被 git 提交，见 .gitignore）
# 用法：cp .env.example .env  然后填真实值
# ============================================================

# ---- 福利吧论坛签到（Go 原生模块，签到中心 /checkin/）----
# 账号也可在网页上直接登录；这里填了则容器首次启动时自动导入。
FORUM_USERNAME=
FORUM_PASSWORD=
# 签到时刻表（北京时间，逗号分隔）
# WNFLB_CHECKIN_TIMES=01:00,22:00
# 启动后是否先跑一次签到（true/false）
# WNFLB_RUN_ON_STARTUP=true
# 论坛基址（论坛换域名时改这里）
# WNFLB_BASE_URL=https://www.wnflb2023.com

# ---- 什么值得买签到（Go 原生模块，签到中心 /checkin/）----
# Cookie 也可在签到中心页面直接粘贴；这里填了则容器首次启动时自动导入。
# 从什么值得买 APP 抓包获取完整 Cookie（须包含 sess 字段）。
# SMZDM_COOKIE=
# 签到时刻表（北京时间，逗号分隔）
# SMZDM_CHECKIN_TIMES=09:00
# 启动后是否先跑一次签到（true/false）
# SMZDM_RUN_ON_STARTUP=true
# 接口基址（一般不用改）
# SMZDM_BASE_URL=https://user-api.smzdm.com

# ---- 签到结果 Bark 推送（签到中心页面也可配置）----
# 首次启动引导：填了则作为默认设备；之后以网页保存的配置为准。
# BARK_SERVER=https://api.day.app
# BARK_KEY=

# ---- 主账号（WorkBuddy/TraeWork）签到 ----
# 启动兜底补签：服务启动时对"已错过今日签到时刻且今日未签"的账号补签
# WB2A_CATCHUP_ON_STARTUP=true
